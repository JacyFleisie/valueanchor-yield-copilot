# Secrets. The OpenRouter key lives here and must never be committed.
backend/.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
backend/.venv/
.venv/

# The generated workspace database. Recreated on first run.
*.db
*.sqlite
*.sqlite3

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Build output: the frozen desktop executable and PyInstaller's work files.
# `dist/ValueAnchor.exe` is the release artifact, built by packaging/build_exe.py.
dist/
build/

# Logs and local scratch
logs/
*.log

# OpenEdge runtime artifacts. The ABL procedures, the DDL and the OpenAPI spec
# in `openedge/` are source and are committed; everything the database engine
# writes while running them is not. The sample databases are rebuilt from those
# procedures, so the binaries only ever add megabytes and merge noise.
openedge/*.b1
openedge/*.d1
openedge/*.d2
openedge/*.lg
openedge/*.st
openedge/*.lic
openedge/*.out
openedge/*.pl
openedge/SQLExplorer.properties
openedge/put-test.txt

# Crash reports the AVM drops in the working directory when a program aborts
# (procore.<pid>: a timestamp, the last action and the ABL call stack). They are
# a debugging aid, not source, and a failed run must not be able to put one in a
# commit - `procore.*` is matched anywhere so it is caught wherever you ran from.
procore.*

# The trained NLU model cache. Rebuilt automatically when the corpus or the
# owner's confirmed questions change, so it is not worth versioning.
backend/.model_cache/

# Coverage artifacts produced by `pytest --cov`.
backend/.coverage
backend/coverage.xml
