# Coverage settings.
#
# The split that matters here is logic versus plumbing. `nlu/planner.py` and
# `yield_engine.py` decide what the owner is told about money, so they are held
# to a high bar. `app.py` is HTTP wiring and the sector seed data, where a
# hundred lines of literals would dilute the number without meaning anything.
[run]
source =
    app
    yield_engine
    nlu
branch = True
omit =
    */tests/*
    */.venv/*
    */__pycache__/*

[report]
show_missing = True
skip_covered = False
precision = 1
# A floor, not a target. Measured at 81.4% overall with the deciding layers well
# above it (planner 89.0%, yield_engine 92.4%), so 80 catches a genuine
# regression - a new endpoint shipped without tests - without failing on noise.
# `nlu/assistant.py` sits near 42% on purpose: every network path in it is
# exercised by the guardrail unit tests rather than by live calls, because the
# suite must never depend on a third party being up.
fail_under = 80
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
