# The copilot's optional assistant. The local NLU still owns every answer and
# every number; this only rephrases and explains. Leave the key empty to run the
# whole product offline with no network call at all.
#
# Copy this file to `.env` and paste your own key. `.env` is gitignored.
OPENROUTER_API_KEY=

# Free models only, tried in order until one answers with valid JSON, so a single
# model being rate-limited or retired does not take the assistant offline.
# The free tier allows 20 requests/minute and 50/day, which is why the local
# model answers first and this is only consulted when it adds something.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
