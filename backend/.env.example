# The copilot's optional assistant. The local NLU still owns every answer and
# every number; this only rephrases and explains. Leave the key empty to run the
# whole product offline with no network call at all.
#
# Copy this file to `.env` and paste your own key. In a source checkout it goes
# in `backend/.env`; for the packaged app, put `.env` beside `ValueAnchor.exe`.
# `.env` is gitignored either way.
OPENROUTER_API_KEY=

# Free models only, tried in order until one answers with valid JSON, so a single
# model being rate-limited or retired does not take the assistant offline.
# The free tier allows 20 requests/minute and 50/day, which is why the local
# model answers first and this is only consulted when it adds something.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# --- The outbound OpenEdge direction (optional) -------------------------------
# ValueAnchor becomes an MCP server on its own with nothing set here: any MCP
# host can call POST /mcp and get the yield engine as tools. These two are for
# the other direction - reading a business's own records and documents.
#
# Leave both empty and the OpenEdge tab reports "not called" and says so, rather
# than presenting the documented default port as a working connection.
#
# OpenEdge MCP Server. The address is only used once the owner has actually
# installed it; the documented default is http://localhost:8500/http.
OPENEDGE_MCP_URL=
OPENEDGE_MCP_TOKEN=

# Progress Agentic RAG Context Box. There is no default, because the address
# carries your account and knowledge-box id.
PROGRESS_RAG_MCP_URL=
PROGRESS_RAG_TOKEN=
